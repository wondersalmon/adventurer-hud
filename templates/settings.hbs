<div class="ws-settings-form">
  {{#each groups}}
    <fieldset class="ws-settings-group">
      <legend>{{label}}</legend>
      {{#each settings}}
        <div class="form-group">
          <label for="adventurer-hud-{{key}}">{{name}}</label>
          <div class="form-fields">
            {{#if choices}}
              <select
                id="adventurer-hud-{{key}}"
                name="{{key}}"
                data-parent-key="{{parentKey}}"
                {{disabledAttribute}}
              >
                {{#each choices}}{{#if selected}}<option
                      value="{{value}}"
                      selected
                    >{{label}}</option>{{else}}<option
                      value="{{value}}"
                    >{{label}}</option>{{/if}}{{/each}}
              </select>
            {{else}}
              {{#if numeric}}
                <div class="ws-settings-range">
                  <div class="ws-settings-range-main">
                    <input
                      id="adventurer-hud-{{key}}"
                      type="range"
                      name="{{key}}"
                      value="{{value}}"
                      min="{{range.min}}"
                      max="{{range.max}}"
                      step="{{range.step}}"
                      aria-label="{{name}}"
                    />
                    <output
                      for="adventurer-hud-{{key}}"
                      aria-live="polite"
                    >{{value}}</output>
                  </div>
                  <div class="ws-settings-range-limits" aria-hidden="true">
                    <span>{{range.min}}</span><span>{{range.max}}</span>
                  </div>
                </div>
              {{else}}
                {{#if disabled}}<input
                    id="adventurer-hud-{{key}}"
                    type="checkbox"
                    name="{{key}}"
                    {{checked value}}
                    disabled
                    data-parent-key="{{parentKey}}"
                  />{{else}}<input
                    id="adventurer-hud-{{key}}"
                    type="checkbox"
                    name="{{key}}"
                    {{checked value}}
                    data-parent-key="{{parentKey}}"
                  />{{/if}}
              {{/if}}
            {{/if}}
          </div>
          <p class="hint">{{hint}}</p>
        </div>
      {{/each}}
    </fieldset>
  {{/each}}
  <footer class="form-footer">
    <button type="submit">
      <i class="fa-solid fa-floppy-disk"></i>
      {{saveLabel}}
    </button>
  </footer>
</div>