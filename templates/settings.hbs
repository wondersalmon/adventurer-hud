<div class="ws-settings-form">
  {{#each groups}}
    <fieldset class="ws-settings-group">
      <legend>{{label}}</legend>
      {{#each settings}}
        <div class="form-group">
          <label for="adventurer-hud-{{key}}">{{name}}</label>
          <div class="form-fields">
            {{#if choices}}
              <select
                id="adventurer-hud-{{key}}"
                name="{{key}}"
                data-parent-key="{{parentKey}}"
                {{disabledAttribute}}
              >
                {{#each choices}}{{#if selected}}<option
                      value="{{value}}"
                      selected
                    >{{label}}</option>{{else}}<option
                      value="{{value}}"
                    >{{label}}</option>{{/if}}{{/each}}
              </select>
            {{else}}
              {{#if disabled}}<input
                  id="adventurer-hud-{{key}}"
                  type="checkbox"
                  name="{{key}}"
                  {{checked value}}
                  disabled
                  data-parent-key="{{parentKey}}"
                />{{else}}<input
                  id="adventurer-hud-{{key}}"
                  type="checkbox"
                  name="{{key}}"
                  {{checked value}}
                  data-parent-key="{{parentKey}}"
                />{{/if}}
            {{/if}}
          </div>
          <p class="hint">{{hint}}</p>
        </div>
      {{/each}}
    </fieldset>
  {{/each}}
  <footer class="form-footer">
    <button type="submit">
      <i class="fa-solid fa-floppy-disk"></i>
      {{saveLabel}}
    </button>
  </footer>
</div>