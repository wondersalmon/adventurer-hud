<div class="ws-settings-form">
  {{#each groups}}
    <fieldset class="ws-settings-group">
      <legend>{{label}}</legend>
      {{#each settings}}
        <div class="form-group">
          <label for="adventurer-hud-{{key}}">{{name}}</label>
          <div class="form-fields">
            <input
              id="adventurer-hud-{{key}}"
              type="checkbox"
              name="{{key}}"
              {{checked value}}
            />
          </div>
          <p class="hint">{{hint}}</p>
        </div>
      {{/each}}
    </fieldset>
  {{/each}}
  <footer class="form-footer">
    <button type="button" data-action="reset">
      <i class="fa-solid fa-arrow-rotate-left"></i>
      {{resetLabel}}
    </button>
    <button type="submit">
      <i class="fa-solid fa-floppy-disk"></i>
      {{saveLabel}}
    </button>
  </footer>
</div>