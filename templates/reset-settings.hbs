<div class="ws-settings-reset">
  <p>{{confirmLabel}}</p>
  <footer class="form-footer">
    <button type="button" data-action="cancel">
      {{cancelLabel}}
    </button>
    <button type="submit">
      <i class="fa-solid fa-arrow-rotate-left"></i>
      {{resetLabel}}
    </button>
  </footer>
</div>