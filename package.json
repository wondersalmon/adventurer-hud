{
  "name": "adventurer-hud",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A player-focused character, rolls and combat HUD for Foundry VTT D&D 5e.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wondersalmon/adventurer-hud.git"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts tools tests && stylelint \"styles/**/*.css\"",
    "test": "node --test",
    "validate": "node tools/validate.mjs",
    "version:sync": "node tools/sync-version.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
