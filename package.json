{
  "name": "adventurer-hud",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "A player-focused character, rolls and combat HUD for Foundry VTT D&D 5e.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wondersalmon/adventurer-hud.git"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate",
    "check:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run validate",
    "typecheck": "tsc --project jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts tools tests test-ui playwright.config.mjs && stylelint \"styles/**/*.css\"",
    "release:notes": "node tools/release-notes.mjs",
    "test": "node tools/test-suite.mjs all",
    "test:runtime": "node tools/test-suite.mjs runtime",
    "test:integration": "node tools/test-suite.mjs integration",
    "test:local": "node tools/test-suite.mjs local",
    "test:coverage": "node tools/test-suite.mjs all --coverage",
    "validate": "node tools/validate.mjs",
    "version:sync": "node tools/sync-version.mjs",
    "test:ui": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "archiver": "^8.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "handlebars": "^4.7.10",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  }
}
