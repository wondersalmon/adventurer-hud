{
  "name": "adventurer-hud",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "description": "A player-focused character, rolls and combat HUD for Foundry VTT D&D 5e.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wondersalmon/adventurer-hud.git"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run validate",
    "check:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run validate",
    "typecheck": "tsc --project jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts tools tests test-ui playwright.config.mjs && stylelint \"styles/**/*.css\"",
    "release:notes": "node tools/release-notes.mjs",
    "test": "node tools/test-suite.mjs all",
    "test:runtime": "node tools/test-suite.mjs runtime",
    "test:integration": "node tools/test-suite.mjs integration",
    "test:local": "node tools/test-suite.mjs local",
    "test:coverage": "node tools/test-suite.mjs all --coverage",
    "validate": "node tools/validate.mjs",
    "version:sync": "node tools/sync-version.mjs",
    "test:ui": "playwright test",
    "release:verify": "node dev/release-tools/bin/package.mjs --verify",
    "release:github": "node dev/release-tools/bin/publish-github.mjs",
    "release:setup": "node tools/files.mjs --setup-release-tools",
    "release:build": "node dev/release-tools/bin/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "archiver": "^8.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "handlebars": "^4.7.10",
    "linkedom": "^0.18.14",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  },
  "foundryRelease": {
    "toolkitRepository": "wondersalmon/foundry-release-tools",
    "revision": "ce0605457e7fe4b12ace77be224d8f9819038de2",
    "sourceReleaseUrls": true,
    "defaultReleaseBuild": true,
    "benchmark": {
      "executable": "node",
      "arguments": [
        "dev/benchmark/run.mjs"
      ],
      "baselinePointer": "dev/benchmarks/last-release.txt"
    },
    "notesHeading": false,
    "packageFiles": {
      "module": "tools/release-package.mjs",
      "export": "collectReleaseFiles"
    },
    "documentationModule": "tools/release-documentation.mjs",
    "localContracts": true
  }
}
